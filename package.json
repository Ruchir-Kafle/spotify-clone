{
	"name": "spotify-clone",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@10.33.4",
	"scripts": {
		"dev": "pnpm --filter @music/web dev",
		"mobile": "pnpm --filter @music/mobile start",
		"mobile:ios": "pnpm --filter @music/mobile ios",
		"start": "pnpm --filter @music/web start",
		"build": "pnpm --filter @music/shared-types build && pnpm --filter @music/database build && pnpm --filter @music/scanner build && pnpm --filter @music/web build",
		"check": "pnpm --filter @music/shared-types check && pnpm --filter @music/database check && pnpm --filter @music/scanner check && pnpm --filter @music/web check && pnpm --filter @music/mobile check",
		"lint": "pnpm --filter @music/web lint",
		"format": "pnpm --recursive --if-present format",
		"db:migrate": "pnpm --filter @music/database migrate",
		"library:add": "pnpm --filter @music/scanner scanner add-dir",
		"library:list": "pnpm --filter @music/scanner scanner list-dirs",
		"library:remove": "pnpm --filter @music/scanner scanner remove-dir",
		"scan": "pnpm --filter @music/scanner scanner scan",
		"scan:watch": "pnpm --filter @music/scanner scanner watch"
	},
	"devDependencies": {
		"prettier": "^3.8.1",
		"typescript": "^6.0.2"
	}
}
