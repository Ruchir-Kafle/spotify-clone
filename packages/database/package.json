{
	"name": "@music/database",
	"version": "0.0.1",
	"type": "module",
	"private": true,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"migrate": "tsx src/migrate.ts",
		"format": "prettier --write ."
	},
	"dependencies": {
		"better-sqlite3": "^12.5.0"
	},
	"devDependencies": {
		"@types/better-sqlite3": "^7.6.13",
		"tsx": "^4.21.0",
		"typescript": "^6.0.2"
	}
}
